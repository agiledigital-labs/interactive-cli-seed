# Mitigate prototype pollution attacks by freezing built-in object prototypes.
# Mitigate script injection attacks by disabling `eval` and `new Function()`.
# See https://developer.mozilla.org/en-US/docs/Web/Security/Attacks/Prototype_pollution
NODE_OPTIONS="--disable-proto=delete --disallow-code-generation-from-strings"

PREFIX_EXAMPLE_ARG="hello from .env"