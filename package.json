{
  "name": "interactive-cli-seed",
  "version": "1.0.0",
  "description": "Seed project to create interactive CLI tools.",
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": "=26",
    "pnpm": ">=11"
  },
  "main": "src/index.ts",
  "bin": {
    "cli-name": "./dist/index.js"
  },
  "author": "Agile Digital",
  "private": true,
  "files": [
    "src"
  ],
  "license": "UNLICENSED",
  "scripts": {
    "prepare": "lefthook install",
    "build": "tsup",
    "start": "node --enable-source-maps dist/index.js",
    "watch": "tsup --watch",
    "test": "vitest run --config=vitest.config.ts",
    "mutation-test": "stryker run",
    "type-check": "tsc --noEmit",
    "type-coverage": "type-coverage",
    "lint": "biome lint",
    "format": "biome format --write",
    "biome-ci": "biome ci src/",
    "biome-check": "biome check",
    "lockfile-lint": "lockfile-lint --path package-lock.json --type npm --allowed-hosts npm --allowed-schemes https:",
    "publint": "publint",
    "knip": "knip --cache",
    "npq": "npq",
    "dependency-cruiser": "depcruise --config .dependency-cruiser.json src/",
    "spell-check": "cspell"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-conventional": "^21.1.0",
    "@cspell/dict-en-gb-mit": "3.1.24",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/typescript-checker": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@types/node": "^26.1.0",
    "@types/yargs": "^17.0.35",
    "@vitest/coverage-v8": "4.1.9",
    "cspell": "^10.0.1",
    "dependency-cruiser": "^18.0.0",
    "knip": "6.23.0",
    "lefthook": "^2.1.9",
    "lockfile-lint": "^5.0.0",
    "npq": "^3.19.6",
    "publint": "^0.3.21",
    "tsup": "^8.5.1",
    "type-coverage": "2.29.7",
    "typescript": "^6.0.3",
    "vitest": "4.1.9"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "yargs": "^18.0.0"
  },
  "typeCoverage": {
    "atLeast": 100,
    "ignoreCatch": false,
    "strict": true,
    "detail": true,
    "updateIfHigher": false,
    "reportUnusedIgnore": true,
    "cache": true,
    "cacheDirectory": ".caches/type-coverage"
  }
}
